FROM node:24.19.0-alpine AS dependencies

RUN npm install --global pnpm@10.32.1
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY gen/ts/package.json ./gen/ts/package.json
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile

FROM node:24.19.0-alpine AS build

RUN npm install --global pnpm@10.32.1
WORKDIR /app

COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/web/node_modules ./web/node_modules
COPY --from=dependencies /app/gen/ts/node_modules ./gen/ts/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY gen/ts ./gen/ts
COPY web ./web

ARG NEXT_PUBLIC_AETHER_API_URL=http://localhost:8080
ENV NEXT_PUBLIC_AETHER_API_URL=$NEXT_PUBLIC_AETHER_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_OUTPUT=standalone

RUN pnpm --filter @aether/web build

FROM node:24.19.0-alpine AS runtime

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=build --chown=nextjs:nodejs /app/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/web/.next/static ./web/.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "web/server.js"]
