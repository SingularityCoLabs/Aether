# Control plane
AETHER_ENVIRONMENT=development
AETHER_HTTP_ADDRESS=:8080
AETHER_DATABASE_URL=postgres://aether:aether@localhost:5432/aether?sslmode=disable
AETHER_DATABASE_REQUIRED=true
AETHER_LOG_LEVEL=debug
AETHER_ALLOWED_ORIGINS=http://localhost:3000
AETHER_SHUTDOWN_TIMEOUT=10s

# Dashboard (read by the browser)
NEXT_PUBLIC_AETHER_API_URL=http://localhost:8080

# PostgreSQL container
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether

