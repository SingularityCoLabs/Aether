{
  "name": "aether",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native self-hosted cloud control plane",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.32.0"
  },
  "scripts": {
    "build": "pnpm --filter @aether/web build",
    "dev": "pnpm --filter @aether/web dev",
    "lint": "pnpm buf:lint && pnpm --filter @aether/web lint",
    "test": "pnpm --filter @aether/web test",
    "typecheck": "pnpm --filter @aether/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "buf:lint": "buf lint",
    "buf:format": "buf format --write",
    "buf:format:check": "buf format --diff --exit-code",
    "buf:generate": "buf generate"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
